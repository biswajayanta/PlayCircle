# Copy this file to .env and fill in your local values.
# NEVER commit the real .env — it's gitignored for a reason.

PLAYCIRCLE_DB_HOST=127.0.0.1
PLAYCIRCLE_PORT=5432
PLAYCIRCLE_USER=postgres
PLAYCIRCLE_PASSWORD=your-local-postgres-password
PLAYCIRCLE_NAME=playcircle

# "disable" for local dev, "require" in Azure (Azure Postgres enforces SSL)
PLAYCIRCLE_DB_SSL_MODE=disable

# Generate a real one for anything beyond local dev:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PLAYCIRCLE_JWT_SECRET_KEY=dev-only-insecure-secret-change-me

# Comma-separated list of allowed frontend origins. "*" is fine for local
# dev only — set a real value in production.
PLAYCIRCLE_CORS_ORIGINS=*
